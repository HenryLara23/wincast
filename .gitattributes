# Order matters: when several lines match a file, the LAST one wins.

# Everything: text files stored with LF and checked out with LF on every OS
# (Python doesn't care, and nothing gets rewritten behind our back on Windows).
*                        text=auto eol=lf
*.iss                    text eol=crlf

# Files checked byte for byte (CORE_MANIFEST.json hashes, SHA256SUMS, the
# golden-game test): never converted at all. Must come AFTER the line above.
src/lolwp/**             -text
src/wincast/resources/** -text
tests/fixtures/**        -text
